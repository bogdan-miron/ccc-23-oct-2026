# Everything is ignored by default; only the kit is tracked. Contest data, PDFs, outputs and notebooks stay local. Solutions are tracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CLAUDE.md
!/AGENTS.md
!/LESSONS.md
!/requirements.txt
!/requirements-extra.txt
!/run.py
!/run.sh
!/setup_env.py
!/setup_env.sh
!/.claude/
!/cf/
!/tools/
!/tests/
!/knowledge/
!/solutions/
!/notes/
!/notebooks/
!/submissions/
# working state inside tracked dirs
/notes/*
/notebooks/*
/submissions/*
!/notes/.gitkeep
!/notebooks/.gitkeep
!/submissions/.gitkeep
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
catboost_info/
